{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spmkit-validation:schema:v0.1:run",
  "title": "Validation run v0.1",
  "$defs": {
    "message": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/identifier"
        },
        "message": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/non_empty_string"
        },
        "evidence_id": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "environment_id",
        "platform",
        "operating_system",
        "architecture",
        "python_version"
      ],
      "properties": {
        "environment_id": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/identifier"
        },
        "platform": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/non_empty_string"
        },
        "operating_system": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/non_empty_string"
        },
        "architecture": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/non_empty_string"
        },
        "python_version": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/non_empty_string"
        },
        "operator_id": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/identifier"
        },
        "instrument_id": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/identifier"
        },
        "laboratory_id": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/identifier"
        },
        "snapshot_artifact_id": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "campaign_id",
        "case_ids",
        "run_type",
        "started_at",
        "finished_at",
        "command",
        "parameters",
        "seed",
        "environment",
        "input_artifact_ids",
        "output_artifact_ids",
        "run_manifest_artifact_id",
        "execution_status",
        "errors",
        "warnings"
      ],
      "properties": {
        "run_id": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/identifier"
        },
        "campaign_id": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/identifier"
        },
        "case_ids": {
          "allOf": [
            {
              "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/id_list"
            },
            {
              "minItems": 1
            }
          ]
        },
        "run_type": {
          "enum": ["SOFTWARE_TEST", "VALIDATION", "REPRODUCIBILITY"]
        },
        "started_at": {
          "oneOf": [
            {"$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/timestamp"},
            {"type": "null"}
          ]
        },
        "finished_at": {
          "oneOf": [
            {"$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/timestamp"},
            {"type": "null"}
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/non_empty_string"
          }
        },
        "parameters": {
          "type": "object"
        },
        "seed": {
          "type": ["integer", "null"]
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "input_artifact_ids": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/id_list"
        },
        "output_artifact_ids": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/id_list"
        },
        "run_manifest_artifact_id": {
          "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/identifier"
        },
        "execution_status": {
          "enum": ["NOT_RUN", "RUNNING", "COMPLETED", "ERROR", "ABORTED"]
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"execution_status": {"const": "NOT_RUN"}},
            "required": ["execution_status"]
          },
          "then": {
            "properties": {
              "started_at": {"type": "null"},
              "finished_at": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"execution_status": {"const": "RUNNING"}},
            "required": ["execution_status"]
          },
          "then": {
            "properties": {
              "started_at": {
                "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/timestamp"
              },
              "finished_at": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"execution_status": {"const": "COMPLETED"}},
            "required": ["execution_status"]
          },
          "then": {
            "properties": {
              "started_at": {
                "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/timestamp"
              },
              "finished_at": {
                "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/timestamp"
              },
              "errors": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_status": {"enum": ["ERROR", "ABORTED"]}
            },
            "required": ["execution_status"]
          },
          "then": {
            "properties": {
              "started_at": {
                "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/timestamp"
              },
              "finished_at": {
                "$ref": "urn:spmkit-validation:schema:v0.1:common#/$defs/timestamp"
              },
              "errors": {"minItems": 1}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
