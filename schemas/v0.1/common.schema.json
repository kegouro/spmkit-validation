{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spmkit-validation:schema:v0.1:common",
  "title": "SPM-Kit validation common definitions v0.1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "relative_or_permitted_uri": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\)(?!file:).+$"
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "uniqueItems": true
    },
    "id_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "determinism_requirement": {
      "enum": [
        "BITWISE_REPEATABLE",
        "CANONICALLY_REPEATABLE",
        "NUMERICALLY_REPEATABLE",
        "SCIENTIFICALLY_REPRODUCIBLE"
      ]
    },
    "validation_level": {
      "enum": [
        "LEVEL 0 — CLAIMED",
        "LEVEL 1 — SOFTWARE_VERIFIED",
        "LEVEL 2 — NUMERICALLY_VERIFIED",
        "LEVEL 3 — CROSS_VALIDATED",
        "LEVEL 4 — PHYSICALLY_VALIDATED",
        "LEVEL 5 — REPRODUCIBILITY_VALIDATED"
      ]
    },
    "responsible_party": {
      "type": "object",
      "required": ["party_id", "name", "role"],
      "properties": {
        "party_id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "organization": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "system_under_test": {
      "type": "object",
      "required": [
        "package_name",
        "version",
        "git_commit",
        "repository",
        "ref",
        "platform",
        "environment_id"
      ],
      "properties": {
        "package_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "git_commit": {
          "$ref": "#/$defs/git_commit"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "platform": {
          "$ref": "#/$defs/non_empty_string"
        },
        "environment_id": {
          "$ref": "#/$defs/identifier"
        },
        "lockfile_artifact_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "campaign": {
      "type": "object",
      "required": [
        "campaign_id",
        "title",
        "objective",
        "protocol_version",
        "status",
        "created_at",
        "frozen_at",
        "system_under_test",
        "intended_validation_level",
        "determinism_requirement",
        "limitations",
        "responsible_parties"
      ],
      "properties": {
        "campaign_id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "objective": {
          "$ref": "#/$defs/non_empty_string"
        },
        "protocol_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "status": {
          "enum": ["DRAFT", "FROZEN", "RUNNING", "COMPLETED", "ABORTED"]
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "frozen_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "system_under_test": {
          "$ref": "#/$defs/system_under_test"
        },
        "intended_validation_level": {
          "$ref": "#/$defs/validation_level"
        },
        "determinism_requirement": {
          "$ref": "#/$defs/determinism_requirement"
        },
        "limitations": {
          "$ref": "#/$defs/limitations"
        },
        "responsible_parties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/responsible_party"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "DRAFT"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "frozen_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "frozen_at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
